# Copy to .env (chmod 600). Provider keys are NOT here: they are read from files (see run.sh, KEYS_DIR).
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongo:27017/LibreChat
SEARCH=false
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
NO_INDEX=true
# generate: openssl rand -hex 32 (JWT_*, CREDS_KEY), openssl rand -hex 16 (CREDS_IV)
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=
# test user created by "run.sh create-user"
LC_TEST_EMAIL=measure@example.test
LC_TEST_PASSWORD=
# upstream origins for the capture proxy (Anthropic and OpenAI default to the public APIs)
# KIMI_BASE_URL=<BASE_URL>
# ZAI_BASE_URL=<BASE_URL>
# G4 only: an existing Code API reachable from the api container (not shipped in this kit). Add the vars your Code API needs
# (key or JWT settings) next to these; the whole file is passed to the api container.
# LIBRECHAT_CODE_BASEURL=http://<CODE_API_HOST>:<PORT>/v1
# LIBRECHAT_CODE_API_KEY=
