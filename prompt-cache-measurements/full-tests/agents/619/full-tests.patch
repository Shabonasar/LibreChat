index 00000000..ab63a2f1
--- /dev/null
+++ b/src/specs/prompt-cache/reasoningReplay.test.ts
@@ -0,0 +1,280 @@
+import type * as t from '@/types';
+import type { LiveTurn } from './liveRun';
+import { restoreHistory, runLiveTurn } from './liveRun';
+import { GraphEvents, Providers } from '@/common';
+import { scriptReply } from './scriptedReplies';
+
+/**
+ * Reasoning replay across model boundaries: blocks are signed by the model
+ * that served the call, so a restored history only carries them back to that
+ * model, and a fallback that served a call owns the blocks of that call.
+ */
+
+jest.setTimeout(120_000);
+
+const PRIMARY = 'claude-primary-test';
+const OTHER = 'claude-other-test';
+const FALLBACK = 'claude-fallback-test';
+
+const agentFor = (model: string, fallbackModel?: string): t.AgentInputs =>
+  ({
+    agentId: 'replay-agent',
+    provider: Providers.ANTHROPIC,
+    clientOptions: {
+      model,
+      apiKey: 'test-key',
+      maxRetries: 0,
+      streaming: true,
+      thinking: { type: 'enabled', budget_tokens: 1024 },
+      maxTokens: 4096,
+      ...(fallbackModel != null && {
+        fallbacks: [
+          {
+            provider: Providers.ANTHROPIC,
+            clientOptions: { model: fallbackModel, apiKey: 'test-key', maxRetries: 0 },
+          },
+        ],
+      }),
+    },
+    instructions: 'Answer support questions.',
+    maxContextTokens: 100_000,
+    providerReasoningReplay: true,
+    toolDefinitions: [
+      {
+        name: 'lookup',
+        description: 'Runs lookup.',
+        parameters: {
+          type: 'object',
+          properties: { query: { type: 'string' } },
+          required: ['query'],
+        },
+      },
+    ],
+  }) as t.AgentInputs;
+
+const tools = new Map<string, string>([['lookup', 'found']]);
+
+async function turn(
+  exchanges: Array<{ user: string; parts?: t.MessageContentComplex[] }>,
+  model: string,
+  replies: unknown[],
+  options: { replayModel?: string; fallbackModel?: string } = {}
+): Promise<LiveTurn> {
+  const live = await runLiveTurn(
+    {
+      agent: agentFor(model, options.fallbackModel),
+      toolResults: tools,
+      eventDriven: true,
+      aggregatedEvents: [GraphEvents.ON_PROVIDER_OUTPUT_ITEMS],
+    },
+    restoreHistory(exchanges, new Set(tools.keys()), {
+      provider: Providers.ANTHROPIC,
+      model: options.replayModel ?? model,
+    }),
+    replies
+  );
+  exchanges[exchanges.length - 1].parts = live.contentParts;
+  return live;
+}
+
+const toolRound = (signature: string): unknown[] => [
+  scriptReply('anthropic', {
+    reasoning: [{ text: 'Looking up.', signature }],
+    calls: [{ name: 'lookup', args: { query: 'x' } }],
+  }),
+  scriptReply('anthropic', {
+    reasoning: [{ text: 'Answering.', signature: `${signature}_FINAL` }],
+    text: 'Done.',
+  }),
+];
+
+const body = (live: LiveTurn, index: number): string =>
+  JSON.stringify(live.requests[index]);
+
+describe('reasoning replay across models', () => {
+  it('replays only to the model that signed the blocks, and not across another model\'s turn', async () => {
+    const exchanges: Array<{ user: string; parts?: t.MessageContentComplex[] }> = [];
+    exchanges.push({ user: 'one' });
+    await turn(exchanges, PRIMARY, toolRound('SIG_A'));
+    exchanges.push({ user: 'two' });
+    const second = await turn(exchanges, OTHER, toolRound('SIG_B'));
+    exchanges.push({ user: 'three' });
+    const third = await turn(exchanges, PRIMARY, toolRound('SIG_C'));
+
+    /** The other model never receives the primary model's signed blocks. */
+    expect(body(second, 0)).not.toContain('SIG_A');
+    expect(body(second, 1)).toContain('SIG_B');
+    expect(body(second, 1)).not.toContain('SIG_A');
+    /** Its turn sits between the primary model's two turns: replaying the first
+     *  turn's blocks around that hole would break the chain they are bound to. */
+    expect(body(third, 0)).not.toContain('SIG_A');
+    expect(body(third, 0)).not.toContain('SIG_B');
+    expect(third.requests).toHaveLength(2);
+    expect(body(third, 1)).toContain('SIG_C');
+  });
+
+  it('replays the turns after a model change once the model has signed them', async () => {
+    const exchanges: Array<{ user: string; parts?: t.MessageContentComplex[] }> = [];
+    exchanges.push({ user: 'one' });
+    await turn(exchanges, PRIMARY, toolRound('SIG_A'));
+    exchanges.push({ user: 'two' });
+    await turn(exchanges, OTHER, toolRound('SIG_B'));
+    exchanges.push({ user: 'three' });
+    await turn(exchanges, OTHER, toolRound('SIG_C'));
+    exchanges.push({ user: 'four' });
+    const fourth = await turn(exchanges, OTHER, toolRound('SIG_D'));
+
+    expect(body(fourth, 0)).not.toContain('SIG_A');
+    expect(body(fourth, 0)).toContain('SIG_B');
+    expect(body(fourth, 0)).toContain('SIG_C');
+  });
+
+  it('attributes the blocks of a call served by a fallback to the fallback model', async () => {
+    const exchanges: Array<{ user: string; parts?: t.MessageContentComplex[] }> = [
+      { user: 'one' },
+    ];
+    const first = await turn(
+      exchanges,
+      PRIMARY,
+      [
+        { failWithStatus: 500 },
+        scriptReply('anthropic', {
+          reasoning: [{ text: 'Fallback thinking.', signature: 'SIG_FB' }],
+          text: 'Served by the fallback.',
+        }),
+      ],
+      { fallbackModel: FALLBACK }
+    );
+    expect(first.requests).toHaveLength(2);
+    const replay = (
+      first.contentParts.find((part) => part.type === 'think') as
+        | t.ReasoningContentText
+        | undefined
+    )?.provider_replay;
+    expect(replay?.anthropic?.model).toBe(FALLBACK);
+
+    exchanges.push({ user: 'two' });
+    const toPrimary = await turn(exchanges, PRIMARY, [
+      scriptReply('anthropic', { text: 'ok' }),
+    ]);
+    expect(body(toPrimary, 0)).not.toContain('SIG_FB');
+
+    const toFallbackModel = await turn(
+      exchanges,
+      FALLBACK,
+      [scriptReply('anthropic', { text: 'ok' })],
+    );
+    expect(body(toFallbackModel, 0)).toContain('SIG_FB');
+  });
+});
+
+describe('Bedrock rejecting replayed reasoning', () => {
+  const BEDROCK_MODEL = 'anthropic.claude-test-v1:0';
+
+  const bedrockTurn = async (
+    exchanges: Array<{ user: string; parts?: t.MessageContentComplex[] }>,
+    replies: unknown[]
+  ): Promise<LiveTurn> => {
+    const live = await runLiveTurn(
+      {
+        agent: {
+          agentId: 'bedrock-replay-agent',
+          provider: Providers.BEDROCK,
+          clientOptions: {
+            model: BEDROCK_MODEL,
+            region: 'us-east-1',
+            credentials: { accessKeyId: 'test', secretAccessKey: 'test' },
+            maxRetries: 0,
+            streaming: true,
+            maxTokens: 4096,
+            additionalModelRequestFields: {
+              thinking: { type: 'enabled', budget_tokens: 1024 },
+            },
+          },
+          instructions: 'Answer support questions.',
+          maxContextTokens: 100_000,
+          providerReasoningReplay: true,
+        } as t.AgentInputs,
+        toolResults: tools,
+        eventDriven: true,
+        transport: 'bedrock',
+      },
+      restoreHistory(exchanges, new Set(tools.keys()), {
+        provider: Providers.BEDROCK,
+        model: BEDROCK_MODEL,
+      }),
+      replies
+    );
+    exchanges[exchanges.length - 1].parts = live.contentParts;
+    return live;
+  };
+
+  const reply = (signature: string): unknown =>
+    scriptReply('bedrock', {
+      reasoning: [{ text: 'Thinking.', signature }],
+      text: 'Answer.',
+    });
+
+  it('retries once without the signed blocks and warns once', async () => {
+    const warn = jest.spyOn(console, 'warn').mockImplementation(() => undefined);
+    try {
+      const exchanges: Array<{ user: string; parts?: t.MessageContentComplex[] }> = [
+        { user: 'one' },
+      ];
+      await bedrockTurn(exchanges, [reply('SIG_B1')]);
+      exchanges.push({ user: 'two' });
+      const second = await bedrockTurn(exchanges, [
+        {
+          failWithStatus: 400,
+          message: 'The signature in the thinking block is not valid for this conversation',
+        },
+        reply('SIG_B2'),
+      ]);
+
+      expect(second.requests).toHaveLength(2);
+      expect(body(second, 0)).toContain('SIG_B1');
+      expect(body(second, 1)).not.toContain('SIG_B1');
+      expect(body(second, 1)).toContain('Answer.');
+      expect(
+        warn.mock.calls.filter(([message]) => String(message).includes('[bedrock]'))
+      ).toHaveLength(1);
+      expect(JSON.stringify(second.contentParts)).toContain('SIG_B2');
+    } finally {
+      warn.mockRestore();
+    }
+  });
+
+  it('does not retry a rejection that is not about reasoning', async () => {
+    const exchanges: Array<{ user: string; parts?: t.MessageContentComplex[] }> = [
+      { user: 'one' },
+    ];
+    await bedrockTurn(exchanges, [reply('SIG_B1')]);
+    exchanges.push({ user: 'two' });
+    const second = await bedrockTurn(exchanges, [
+      { failWithStatus: 400, message: 'Malformed input request' },
+      reply('SIG_B2'),
+    ]);
+
+    expect(second.requests).toHaveLength(1);
+  });
+
+  it('retries only once', async () => {
+    const warn = jest.spyOn(console, 'warn').mockImplementation(() => undefined);
+    try {
+      const exchanges: Array<{ user: string; parts?: t.MessageContentComplex[] }> = [
+        { user: 'one' },
+      ];
+      await bedrockTurn(exchanges, [reply('SIG_B1')]);
+      exchanges.push({ user: 'two' });
+      const rejected = {
+        failWithStatus: 400,
+        message: 'thinking signature rejected',
+      };
+      const second = await bedrockTurn(exchanges, [rejected, rejected, reply('SIG_B2')]);
+
+      expect(second.requests).toHaveLength(2);
+    } finally {
+      warn.mockRestore();
+    }
+  });
+});
diff --git a/src/specs/prompt-cache/responsesToolRounds.test.ts b/src/specs/prompt-cache/responsesToolRounds.test.ts
new file mode 100644
index 00000000..7fb28b6f
--- /dev/null
+++ b/src/specs/prompt-cache/responsesToolRounds.test.ts
@@ -0,0 +1,303 @@
+import { tool } from '@langchain/core/tools';
+import type * as t from '@/types';
+import type { Json } from './harness';
+import type { JsonObject, LiveTurn } from './liveRun';
+import { firstTurnMessages, restoreHistory, runLiveTurn } from './liveRun';
+import { ContentTypes, GraphEvents, Providers } from '@/common';
+
+/**
+ * OpenAI Responses: a tool round restored from stored parts must serialize to
+ * the input items the live run sent (item ids, status, reasoning items, no
+ * empty assistant message), so every request starts with the previous one.
+ */
+
+type Reasoning = 'encrypted' | 'reference' | 'none';
+
+interface ScriptedRound {
+  text?: string;
+  calls?: Array<{ name: string; query: string }>;
+}
+
+let responseCount = 0;
+
+function frame(event: JsonObject): string {
+  return `event: ${String(event.type)}\ndata: ${JSON.stringify(event)}\n\n`;
+}
+
+function usage(): JsonObject {
+  return {
+    input_tokens: 10,
+    output_tokens: 5,
+    total_tokens: 15,
+    input_tokens_details: { cached_tokens: 0 },
+    output_tokens_details: { reasoning_tokens: 0 },
+  };
+}
+
+/** Provider output items for one model response, then its stream frames. */
+function responseStream(reasoning: Reasoning, round: ScriptedRound): string[] {
+  const n = ++responseCount;
+  const output: JsonObject[] = [];
+  if (reasoning !== 'none') {
+    output.push({
+      id: `rs_${n}`,
+      type: 'reasoning',
+      summary: [{ type: 'summary_text', text: `Thinking ${n}.` }],
+      ...(reasoning === 'encrypted' && { encrypted_content: `ENC_${n}` }),
+    });
+  }
+  if (round.text != null) {
+    output.push({
+      id: `msg_${n}`,
+      type: 'message',
+      status: 'completed',
+      content: [
+        { type: 'output_text', annotations: [], logprobs: [], text: round.text },
+      ],
+      role: 'assistant',
+    });
+  }
+  for (const [index, call] of (round.calls ?? []).entries()) {
+    output.push({
+      id: `fc_${n}_${index}`,
+      type: 'function_call',
+      status: 'completed',
+      arguments: JSON.stringify({ query: call.query }),
+      call_id: `call_${n}_${index}`,
+      name: call.name,
+    });
+  }
+  const response = {
+    id: `resp_${n}`,
+    object: 'response',
+    created_at: Math.floor(Date.now() / 1000),
+    model: 'gpt-5',
+    usage: usage(),
+  };
+  const frames = [
+    frame({
+      type: 'response.created',
+      sequence_number: 0,
+      response: { ...response, status: 'in_progress', output: [] },
+    }),
+  ];
+  output.forEach((item, outputIndex) => {
+    const sequence = frames.length;
+    if (item.type === 'message') {
+      frames.push(
+        frame({
+          type: 'response.output_item.added',
+          sequence_number: sequence,
+          output_index: outputIndex,
+          item: { ...item, status: 'in_progress', content: [] },
+        }),
+        frame({
+          type: 'response.output_text.delta',
+          sequence_number: sequence + 1,
+          item_id: item.id,
+          output_index: outputIndex,
+          content_index: 0,
+          delta: round.text ?? '',
+          logprobs: [],
+        })
+      );
+    } else if (item.type === 'function_call') {
+      frames.push(
+        frame({
+          type: 'response.output_item.added',
+          sequence_number: sequence,
+          output_index: outputIndex,
+          item: { ...item, status: 'in_progress', arguments: '' },
+        }),
+        frame({
+          type: 'response.function_call_arguments.delta',
+          sequence_number: sequence + 1,
+          item_id: item.id,
+          output_index: outputIndex,
+          delta: item.arguments,
+        })
+      );
+    } else {
+      frames.push(
+        frame({
+          type: 'response.output_item.added',
+          sequence_number: sequence,
+          output_index: outputIndex,
+          item: { id: item.id, type: 'reasoning', summary: [] },
+        })
+      );
+    }
+    frames.push(
+      frame({
+        type: 'response.output_item.done',
+        sequence_number: frames.length,
+        output_index: outputIndex,
+        item,
+      })
+    );
+  });
+  frames.push(
+    frame({
+      type: 'response.completed',
+      sequence_number: frames.length,
+      response: { ...response, status: 'completed', output },
+    })
+  );
+  return frames;
+}
+
+const TOOL_NAMES = new Set(['lookup_order', 'search_docs']);
+
+function responsesAgent(
+  eventDriven: boolean,
+  clientOptions: Record<string, Json> = {}
+): t.AgentInputs {
+  const definitions = [...TOOL_NAMES].map((name) => ({
+    name,
+    description: `Runs ${name}.`,
+    parameters: {
+      type: 'object' as const,
+      properties: { query: { type: 'string' as const } },
+      required: ['query'],
+    },
+  }));
+  return {
+    agentId: 'responses-agent',
+    provider: Providers.OPENAI,
+    clientOptions: {
+      model: 'gpt-5',
+      apiKey: 'test-key',
+      maxRetries: 0,
+      streaming: true,
+      useResponsesApi: true,
+      ...clientOptions,
+    },
+    instructions: 'Answer support questions.',
+    maxContextTokens: 100_000,
+    ...(eventDriven
+      ? { toolDefinitions: definitions }
+      : {
+        tools: definitions.map((definition) =>
+          tool(async () => `${definition.name} result`, {
+            name: definition.name,
+            description: definition.description,
+            schema: definition.parameters,
+          })
+        ),
+      }),
+  } as unknown as t.AgentInputs;
+}
+
+const inputOf = (request: JsonObject | undefined): Json[] =>
+  Array.isArray(request?.input) ? request.input : [];
+
+/** Every request's input starts with the previous request's whole input. */
+function expectStrictPrefixes(requests: JsonObject[]): void {
+  for (let i = 1; i < requests.length; i++) {
+    const before = JSON.stringify(inputOf(requests[i - 1])).slice(0, -1);
+    const after = JSON.stringify(inputOf(requests[i]));
+    expect(after.startsWith(before)).toBe(true);
+  }
+}
+
+const isEmptyAssistantMessage = (item: Json): boolean =>
+  item != null &&
+  typeof item === 'object' &&
+  !Array.isArray(item) &&
+  item.role === 'assistant' &&
+  (item.content === '' ||
+    (Array.isArray(item.content) && item.content.length === 0));
+
+const TURNS: Array<{ user: string; rounds: ScriptedRound[]; answer: string }> = [
+  {
+    user: 'Where are orders 1 and 2?',
+    rounds: [
+      {
+        calls: [
+          { name: 'lookup_order', query: '1' },
+          { name: 'lookup_order', query: '2' },
+        ],
+      },
+      { text: 'Checking the policy too.', calls: [{ name: 'search_docs', query: 'shipping' }] },
+      { calls: [{ name: 'lookup_order', query: '3' }] },
+    ],
+    answer: 'Both ship today.',
+  },
+  {
+    user: 'And the warranty?',
+    rounds: [{ calls: [{ name: 'search_docs', query: 'warranty' }] }],
+    answer: 'Two years.',
+  },
+  { user: 'Thanks.', rounds: [], answer: 'You are welcome.' },
+];
+
+async function runConversation(
+  agent: t.AgentInputs,
+  eventDriven: boolean,
+  reasoning: Reasoning,
+  aggregatedEvents: GraphEvents[] = [GraphEvents.ON_PROVIDER_OUTPUT_ITEMS]
+): Promise<LiveTurn[]> {
+  const options = { agent, toolResults: new Map(), eventDriven, aggregatedEvents };
+  const turns: LiveTurn[] = [];
+  const exchanges: Array<{ user: string; parts?: t.MessageContentComplex[] }> = [];
+  for (const turn of TURNS) {
+    exchanges.push({ user: turn.user });
+    const messages =
+      turns.length === 0
+        ? firstTurnMessages(turn.user)
+        : restoreHistory(exchanges, TOOL_NAMES);
+    const streams = [
+      ...turn.rounds.map((round) => responseStream(reasoning, round)),
+      responseStream(reasoning, { text: turn.answer }),
+    ];
+    const live = await runLiveTurn(options, messages, streams);
+    expect(live.requests).toHaveLength(streams.length);
+    turns.push(live);
+    exchanges[exchanges.length - 1].parts = live.contentParts;
+  }
+  return turns;
+}
+
+describe('Responses tool rounds restored across turns', () => {
+  const eventDriven = true;
+  it.each(['encrypted', 'reference'] as Reasoning[])(
+    'keeps every request a prefix continuation with reasoning %s',
+    async (reasoning) => {
+      const turns = await runConversation(
+        responsesAgent(eventDriven),
+        eventDriven,
+        reasoning
+      );
+      const requests = turns.flatMap((turn) => turn.requests);
+      expectStrictPrefixes(requests);
+
+      const last = inputOf(requests[requests.length - 1]);
+      expect(last.some(isEmptyAssistantMessage)).toBe(false);
+      const serialized = JSON.stringify(last);
+      expect(serialized).toMatch(/"id":"fc_\d+_0","type":"function_call","status":"completed"/);
+      expect(serialized).toMatch(/"id":"msg_\d+","type":"message","status":"completed"/);
+      expect(/"id":"rs_\d+"/.test(serialized)).toBe(reasoning !== 'none');
+
+      const stored = turns[0].contentParts.filter(
+        (part): part is t.ToolCallContent => part.type === ContentTypes.TOOL_CALL
+      );
+      expect(stored.every((part) => part.tool_call?.providerItems != null)).toBe(
+        true
+      );
+    }
+  );
+});
+
+describe('Responses tool rounds restored without the stored items', () => {
+  it('falls back to field conversion without an empty assistant message', async () => {
+    const turns = await runConversation(
+      responsesAgent(false),
+      false,
+      'encrypted',
+      []
+    );
+    const restored = inputOf(turns[1].requests[0]);
+    expect(restored.some(isEmptyAssistantMessage)).toBe(false);
+    expect(JSON.stringify(restored)).not.toContain('"id":"fc_');
+  });
+});
diff --git a/src/specs/prompt-cache/restoredToolRounds.test.ts b/src/specs/prompt-cache/restoredToolRounds.test.ts
