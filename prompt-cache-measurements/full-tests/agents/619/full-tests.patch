--- /dev/null
+++ b/src/messages/formatAgentMessages.bedrockReplay.test.ts
@@ -0,0 +1,141 @@
+import { AIMessage, ToolMessage } from '@langchain/core/messages';
+import type { TPayload } from '@/types';
+import { ContentTypes, Providers } from '@/common';
+import { formatAgentMessages } from './format';
+
+const model = 'anthropic.claude-sonnet-5-20260701-v1:0';
+const payload: TPayload = [
+  {
+    role: 'assistant',
+    content: [
+      {
+        type: ContentTypes.THINK,
+        think: 'reasoned answer',
+        provider_replay: {
+          bedrock: {
+            model,
+            blocks: [
+              {
+                type: ContentTypes.REASONING_CONTENT,
+                reasoningText: {
+                  text: 'reasoned answer',
+                  signature: 'sig-bedrock',
+                },
+              },
+            ],
+          },
+        },
+      },
+      {
+        type: ContentTypes.TOOL_CALL,
+        tool_call: {
+          id: 'tool-1',
+          name: 'calculator',
+          args: { expression: '6 * 7' },
+          output: '42',
+        },
+      },
+      {
+        type: ContentTypes.TEXT,
+        text: '42',
+      },
+    ],
+  },
+];
+
+describe('formatAgentMessages Bedrock reasoning replay', () => {
+  it('reconstructs signed native reasoning before its Bedrock tool call', () => {
+    const { messages, indexTokenCountMap } = formatAgentMessages(
+      payload,
+      { 0: 500 },
+      new Set(['calculator']),
+      undefined,
+      {
+        replayProviderReasoning: { provider: Providers.BEDROCK, model },
+      }
+    );
+
+    expect(messages).toHaveLength(3);
+    expect(messages[0]).toBeInstanceOf(AIMessage);
+    expect(messages[0].content).toEqual([
+      {
+        type: ContentTypes.REASONING_CONTENT,
+        reasoningText: {
+          text: 'reasoned answer',
+          signature: 'sig-bedrock',
+        },
+      },
+    ]);
+    expect((messages[0] as AIMessage).tool_calls).toEqual([
+      {
+        id: 'tool-1',
+        name: 'calculator',
+        args: { expression: '6 * 7' },
+      },
+    ]);
+    expect(messages[1]).toBeInstanceOf(ToolMessage);
+    expect(messages[2].content).toBe('42');
+    // Replayed blocks are not part of the stored weight, so it is recounted.
+    expect(indexTokenCountMap).toEqual({});
+  });
+
+  it('does not replay a Bedrock signature to another provider and keeps its token weight', () => {
+    const { messages, indexTokenCountMap } = formatAgentMessages(
+      payload,
+      { 0: 500 },
+      new Set(['calculator']),
+      undefined,
+      {
+        replayProviderReasoning: { provider: Providers.ANTHROPIC, model: 'claude-sonnet-5' },
+      }
+    );
+
+    expect(JSON.stringify(messages)).not.toContain('sig-bedrock');
+    expect(JSON.stringify(messages)).not.toContain('reasoning_content');
+    expect(
+      Object.values(indexTokenCountMap ?? {}).reduce((total, count) => total + count, 0)
+    ).toBe(500);
+  });
+
+  it('does not replay signed reasoning to another Bedrock model', () => {
+    const { messages, indexTokenCountMap } = formatAgentMessages(
+      payload,
+      { 0: 500 },
+      new Set(['calculator']),
+      undefined,
+      {
+        replayProviderReasoning: { provider: Providers.BEDROCK, model: 'amazon.nova-2-lite-v1:0' },
+      }
+    );
+
+    expect(JSON.stringify(messages)).not.toContain('sig-bedrock');
+    expect(JSON.stringify(messages)).not.toContain('reasoning_content');
+    expect(
+      Object.values(indexTokenCountMap ?? {}).reduce((total, count) => total + count, 0)
+    ).toBe(500);
+  });
+
+  it('drops incomplete persisted reasoning instead of sending unsigned native content', () => {
+    const incompletePayload = structuredClone(payload);
+    const think = incompletePayload[0].content?.[0];
+    if (typeof think === 'object' && 'provider_replay' in think) {
+      const block = think.provider_replay.bedrock?.blocks[0];
+      if (block?.reasoningText != null) {
+        block.reasoningText.signature = '';
+      }
+    }
+
+    const { messages } = formatAgentMessages(
+      incompletePayload,
+      undefined,
+      new Set(['calculator']),
+      undefined,
+      {
+        replayProviderReasoning: { provider: Providers.BEDROCK, model },
+      }
+    );
+
+    expect(JSON.stringify(messages)).not.toContain('reasoning_content');
+    expect(JSON.stringify(messages)).not.toContain('sig-bedrock');
+  });
+});
diff --git a/src/messages/responsesToolRounds.test.ts b/src/messages/responsesToolRounds.test.ts
new file mode 100644
index 00000000..c0de17bb
--- /dev/null
+++ b/src/messages/responsesToolRounds.test.ts
@@ -0,0 +1,192 @@
+import { AIMessage } from '@langchain/core/messages';
+import type { BaseMessage } from '@langchain/core/messages';
+import type { OpenAI as OpenAIClient } from 'openai';
+import {
+  OPENAI_RESPONSES_ORIGIN_KEY,
+  MAX_PROVIDER_ITEMS_CHARS,
+  restoreResponsesToolRound,
+  sliceResponsesToolRound,
+  gateResponsesProviderOutput,
+} from './responsesToolRounds';
+
+type OutputItem = OpenAIClient.Responses.ResponseOutputItem;
+
+const ORIGIN = 'origin-a';
+const outputOf = (message: BaseMessage): OutputItem[] | undefined =>
+  (message as AIMessage).response_metadata.output as OutputItem[] | undefined;
+const reasoning = (id: string, encrypted?: string): OutputItem => ({
+  id,
+  type: 'reasoning',
+  summary: [],
+  ...(encrypted != null && { encrypted_content: encrypted }),
+});
+const functionCall = (index: number): OutputItem => ({
+  id: `fc_${index}`,
+  type: 'function_call',
+  status: 'completed',
+  arguments: '{}',
+  call_id: `call_${index}`,
+  name: 'lookup',
+});
+const toolRound = (output: OutputItem[], createdAt = 1_000): AIMessage =>
+  new AIMessage({
+    content: '',
+    tool_calls: output.flatMap((item) =>
+      item.type === 'function_call'
+        ? [{ id: item.call_id, name: item.name, args: {} }]
+        : []
+    ),
+    response_metadata: {
+      output,
+      created_at: createdAt,
+      [OPENAI_RESPONSES_ORIGIN_KEY]: ORIGIN,
+    },
+  });
+
+describe('Responses tool round items', () => {
+  it('slices after each call and keeps trailing items with the last call', () => {
+    const output = [reasoning('rs_1'), functionCall(1), functionCall(2), reasoning('rs_2')];
+    const slices = sliceResponsesToolRound(toolRound(output));
+    expect(slices?.map(({ id, providerItems }) => [id, providerItems.items.map((item) => item.id)])).toEqual([
+      ['call_1', ['rs_1', 'fc_1']],
+      ['call_2', ['fc_2', 'rs_2']],
+    ]);
+  });
+
+  it('restores only when every call carries a matching slice', () => {
+    const output = [functionCall(1), functionCall(2)];
+    const slices = sliceResponsesToolRound(toolRound(output)) ?? [];
+    const restored = new AIMessage({ content: '', tool_calls: toolRound(output).tool_calls });
+    restoreResponsesToolRound(restored, [slices[0].providerItems, undefined]);
+    expect(outputOf(restored)).toBeUndefined();
+    restoreResponsesToolRound(
+      restored,
+      slices.map((slice) => slice.providerItems)
+    );
+    expect(outputOf(restored)).toEqual(output);
+  });
+
+  it('drops reasoning references older than the stored response retention', () => {
+    const output = [reasoning('rs_ref'), reasoning('rs_enc', 'ENC'), functionCall(1)];
+    const now = 1_000 + 31 * 24 * 60 * 60;
+    const [fresh] = gateResponsesProviderOutput([toolRound(output, now)], ORIGIN, false, now);
+    expect(outputOf(fresh)).toEqual(output);
+    const [stale] = gateResponsesProviderOutput([toolRound(output)], ORIGIN, false, now);
+    expect(outputOf(stale)?.map((item) => item.id)).toEqual([
+      'rs_enc',
+      'fc_1',
+    ]);
+  });
+});
+
+describe('Responses replay gate', () => {
+  const now = 1_000 + 31 * 24 * 60 * 60;
+  const output = [reasoning('rs_ref'), reasoning('rs_enc', 'ENC'), functionCall(1)];
+  const gate = (
+    message: AIMessage,
+    options: { origin?: string; zdr?: boolean; at?: number } = {}
+  ): AIMessage =>
+    gateResponsesProviderOutput(
+      [message],
+      options.origin ?? ORIGIN,
+      options.zdr ?? false,
+      options.at ?? now
+    )[0] as AIMessage;
+
+  it('keeps provider output for the producing origin, outside ZDR', () => {
+    const message = toolRound(output, now);
+    expect(gate(message)).toBe(message);
+  });
+
+  it('drops provider output and its origin stamp under ZDR', () => {
+    const gated = gate(toolRound(output, now), { zdr: true });
+    expect(outputOf(gated)).toBeUndefined();
+    expect(gated.response_metadata[OPENAI_RESPONSES_ORIGIN_KEY]).toBeUndefined();
+    expect(gated.tool_calls).toHaveLength(1);
+  });
+
+  it('drops provider output produced by another model or endpoint', () => {
+    const gated = gate(toolRound(output, now), { origin: 'origin-b' });
+    expect(outputOf(gated)).toBeUndefined();
+    expect(gated.response_metadata[OPENAI_RESPONSES_ORIGIN_KEY]).toBeUndefined();
+  });
+
+  it('drops a stamped message whose output is not an array', () => {
+    const message = new AIMessage({
+      content: 'text',
+      response_metadata: { output: 'broken', [OPENAI_RESPONSES_ORIGIN_KEY]: ORIGIN },
+    });
+    expect(outputOf(gate(message))).toBeUndefined();
+  });
+
+  it('keeps an encrypted reasoning item however old, and a reference up to the retention limit', () => {
+    const limit = 29 * 24 * 60 * 60;
+    expect(outputOf(gate(toolRound(output), { at: 1_000 + limit }))?.map((item) => item.id)).toEqual([
+      'rs_ref',
+      'rs_enc',
+      'fc_1',
+    ]);
+    expect(outputOf(gate(toolRound(output), { at: 1_000 + limit + 1 }))?.map((item) => item.id)).toEqual([
+      'rs_enc',
+      'fc_1',
+    ]);
+  });
+
+  it('reads the age from the injected time, not the system clock', () => {
+    const message = toolRound([reasoning('rs_ref'), functionCall(1)], 5_000_000_000);
+    expect(outputOf(gate(message, { at: 5_000_000_000 + 40 * 24 * 60 * 60 }))?.map((item) => item.id)).toEqual(['fc_1']);
+    expect(gate(message, { at: 5_000_000_000 + 60 })).toBe(message);
+  });
+
+  it('turns a tool round with no output and empty text into an empty content array', () => {
+    const message = new AIMessage({
+      content: '',
+      tool_calls: [{ id: 'call_1', name: 'lookup', args: {} }],
+    });
+    expect(gate(message).content).toEqual([]);
+    const withText = new AIMessage({
+      content: 'text',
+      tool_calls: [{ id: 'call_1', name: 'lookup', args: {} }],
+    });
+    expect(gate(withText)).toBe(withText);
+  });
+});
+
+describe('Responses provider items trust boundary', () => {
+  const webSearch = {
+    id: 'ws_1',
+    type: 'web_search_call',
+    status: 'completed',
+  } as unknown as OutputItem;
+  const stored = (items: OutputItem[]) => ({ origin: ORIGIN, items });
+  const restoreWith = (items: OutputItem[]): OutputItem[] | undefined => {
+    const message = new AIMessage({
+      content: '',
+      tool_calls: [{ id: 'call_1', name: 'lookup', args: {} }],
+    });
+    restoreResponsesToolRound(message, [stored(items)]);
+    return outputOf(message);
+  };
+
+  it('does not store a round that holds a provider tool item', () => {
+    expect(sliceResponsesToolRound(toolRound([webSearch, functionCall(1)]))).toBeUndefined();
+  });
+
+  it('does not store a round over the size cap', () => {
+    const big = reasoning('rs_big', 'x'.repeat(MAX_PROVIDER_ITEMS_CHARS));
+    expect(sliceResponsesToolRound(toolRound([big, functionCall(1)]))).toBeUndefined();
+  });
+
+  it('restores nothing from items of a type outside the allowlist', () => {
+    expect(restoreWith([functionCall(1)])).toEqual([functionCall(1)]);
+    expect(restoreWith([webSearch, functionCall(1)])).toBeUndefined();
+    expect(restoreWith([{ type: 'computer_call' } as unknown as OutputItem, functionCall(1)])).toBeUndefined();
+  });
+
+  it('restores nothing from malformed or oversized stored items', () => {
+    expect(restoreWith([null as unknown as OutputItem, functionCall(1)])).toBeUndefined();
+    expect(
+      restoreWith([reasoning('rs_big', 'x'.repeat(MAX_PROVIDER_ITEMS_CHARS)), functionCall(1)])
+    ).toBeUndefined();
+  });
+});
diff --git a/src/specs/prompt-cache/liveRestore.test.ts b/src/specs/prompt-cache/liveRestore.test.ts
new file mode 100644
index 00000000..8ccef064
--- /dev/null
+++ b/src/specs/prompt-cache/liveRestore.test.ts
@@ -0,0 +1,443 @@
+import { tool } from '@langchain/core/tools';
+import type * as t from '@/types';
+import type { Json } from './harness';
+import type {
+  Protocol,
+  ScriptedReply,
+  ScriptedReasoning,
+} from './scriptedReplies';
+import type { LiveTurn, ToolOutput } from './liveRun';
+import { restoreHistory, runLiveTurn } from './liveRun';
+import type { ProviderCase } from './providers';
+import { PROVIDER_CASES } from './providers';
+import { scriptReply } from './scriptedReplies';
+import { GraphEvents, Providers } from '@/common';
+
+/**
+ * The strongest cache invariant: a turn restored from the parts a host
+ * stored must serialize exactly like the live requests of that turn. For
+ * every provider client, the first request of turn N+1 starts, segment by
+ * segment and byte for byte, with the last request of turn N. Only cache
+ * markers, which move to the newest turn by design, are set aside.
+ */
+
+jest.setTimeout(120_000);
+
+const PROTOCOLS: Record<string, Protocol> = {
+  openAI: 'chat',
+  'openAI responses': 'responses',
+  'openAI-compatible endpoint': 'chat',
+  azureOpenAI: 'chat',
+  deepseek: 'chat',
+  xai: 'chat',
+  moonshot: 'chat',
+  anthropic: 'anthropic',
+  'anthropic promptCache': 'anthropic',
+  openrouter: 'chat',
+  'openrouter promptCache': 'chat',
+  bedrock: 'bedrock',
+  'bedrock promptCache': 'bedrock',
+  google: 'google',
+};
+
+const PIXEL_PNG =
+  'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==';
+
+const TOOL_OUTPUTS = new Map<string, ToolOutput>([
+  ['lookup_order', 'Order 42: packed, ships tomorrow'],
+  ['search_docs', 'Returns: thirty days'],
+  [
+    'take_screenshot',
+    [
+      { type: 'text', text: 'Screenshot of the order page' },
+      { type: 'image_url', image_url: { url: `data:image/png;base64,${PIXEL_PNG}` } },
+    ] as t.MessageContentComplex[],
+  ],
+  [
+    'read_page',
+    [
+      { type: 'text', text: 'Shipping page' },
+      { type: 'text', text: 'Orders ship within two days.' },
+    ] as t.MessageContentComplex[],
+  ],
+]);
+
+interface TurnScript {
+  user: string;
+  replies: ScriptedReply[];
+}
+
+const TURNS: TurnScript[] = [
+  {
+    user: 'Where are orders 41 and 42?',
+    replies: [
+      {
+        calls: [
+          { name: 'lookup_order', args: { query: '41' } },
+          { name: 'lookup_order', args: { query: '42' } },
+        ],
+      },
+      {
+        text: 'Checking the policy too.',
+        calls: [{ name: 'search_docs', args: { query: 'returns' } }],
+      },
+      { text: 'Both ship tomorrow; returns within thirty days.' },
+    ],
+  },
+  {
+    user: 'What does the shipping page say?',
+    replies: [
+      {
+        calls: [
+          { name: 'read_page', args: { query: 'shipping' } },
+          { name: 'search_docs', args: { query: 'shipping' } },
+        ],
+      },
+      { text: 'Orders ship within two days.' },
+    ],
+  },
+  {
+    user: 'Show me the order page.',
+    replies: [
+      { text: '', calls: [{ name: 'take_screenshot', args: { query: 'order' } }] },
+      { text: 'Here it is.' },
+    ],
+  },
+  { user: 'Thanks.', replies: [{ text: 'You are welcome.' }] },
+];
+
+function definitions(): t.LCTool[] {
+  return [...TOOL_OUTPUTS.keys()].map((name) => ({
+    name,
+    description: `Runs ${name}.`,
+    parameters: {
+      type: 'object',
+      properties: { query: { type: 'string' } },
+      required: ['query'],
+    },
+  }));
+}
+
+function agentFor(
+  clientOptions: t.ClientOptions,
+  provider: t.AgentInputs['provider'],
+  eventDriven: boolean
+): t.AgentInputs {
+  const tools = definitions();
+  return {
+    agentId: 'live-restore-agent',
+    provider,
+    clientOptions: { ...clientOptions, streaming: true },
+    instructions: 'Answer support questions.',
+    maxContextTokens: 100_000,
+    ...(eventDriven
+      ? { toolDefinitions: tools }
+      : {
+        tools: tools.map((definition) =>
+          tool(async () => TOOL_OUTPUTS.get(definition.name) ?? '', {
+            name: definition.name,
+            description: definition.description ?? '',
+            schema: definition.parameters as Record<string, unknown>,
+          })
+        ),
+      }),
+  } as t.AgentInputs;
+}
+
+function isObject(value: Json): value is { [key: string]: Json } {
+  return value != null && typeof value === 'object' && !Array.isArray(value);
+}
+
+/** Drops cache markers, which move to the newest turn by design. */
+function withoutCacheMarkers(value: Json): Json {
+  if (Array.isArray(value)) {
+    return value
+      .filter((item) => !(isObject(item) && Object.keys(item).length === 1 && 'cachePoint' in item))
+      .map((item) => withoutCacheMarkers(item));
+  }
+  if (!isObject(value)) {
+    return value;
+  }
+  const entries: [string, Json][] = [];
+  for (const [key, nested] of Object.entries(value)) {
+    if (key === 'cache_control') {
+      continue;
+    }
+    entries.push([
+      key,
+      withoutCacheMarkers(nested),
+    ]);
+  }
+  return Object.fromEntries(entries);
+}
+
+function segments(
+  reduce: (body: Json) => { tools: Json[]; system: Json; messages: Json[] },
+  body: Json,
+  marked: boolean
+): string[] {
+  const request = reduce(body);
+  const normalize = (value: Json): string =>
+    JSON.stringify(marked ? withoutCacheMarkers(value) : value);
+  return [
+    ...request.tools.map((segment) => normalize(segment)),
+    normalize(request.system),
+    ...request.messages.map((message) => normalize(message)),
+  ];
+}
+
+const thinkingCase = (
+  name: string,
+  base: string,
+  extra: Record<string, Json>
+): ProviderCase => {
+  const providerCase = PROVIDER_CASES.find((candidate) => candidate.name === base);
+  if (providerCase == null) {
+    throw new Error(`Unknown provider case ${base}`);
+  }
+  return {
+    ...providerCase,
+    name,
+    clientOptions: () =>
+      ({ ...providerCase.clientOptions(), ...extra }) as t.ClientOptions,
+  };
+};
+
+const ANTHROPIC_THINKING = { thinking: { type: 'enabled', budget_tokens: 1024 }, maxTokens: 4096 };
+const BEDROCK_THINKING = {
+  additionalModelRequestFields: { thinking: { type: 'enabled', budget_tokens: 1024 } },
+  maxTokens: 4096,
+};
+
+/**
+ * Reasoning the provider requires back on tool rounds: signed `thinking`
+ * (including empty text) and `redacted_thinking` must reach the follow-up
+ * request of their turn unchanged. Every scripted reply gets its own
+ * signatures, so a block restored from the wrong reply or position shows up.
+ *
+ * `keepsPriorThinking` cases run the host side of reasoning replay (the agent
+ * captures `provider_replay`, history is restored with
+ * `replayProviderReasoning`) and must keep earlier turns' thinking blocks
+ * byte for byte at the turn boundary. The other cases are the baseline
+ * without replay, which sets those blocks aside.
+ */
+interface ThinkingCase {
+  providerCase: ProviderCase;
+  reasoning: ScriptedReasoning[];
+  /** Reasoning emitted after the text of a reply (interleaved thinking). */
+  reasoningAfterText?: ScriptedReasoning[];
+  keepsPriorThinking: boolean;
+}
+
+const SIGNED = [{ text: 'Reasoning.', signature: 'SIG_SIGNED' }];
+const REDACTED_AND_EMPTY = [
+  { redacted: 'REDACTED_DATA' },
+  { text: '', signature: 'SIG_EMPTY_TEXT' },
+];
+const MID_REPLY = [{ text: 'Reasoning after the text.', signature: 'SIG_AFTER' }];
+
+const THINKING_CASES: ThinkingCase[] = [
+  { providerCase: thinkingCase('anthropic thinking', 'anthropic', ANTHROPIC_THINKING), reasoning: SIGNED, keepsPriorThinking: false },
+  { providerCase: thinkingCase('anthropic thinking redacted', 'anthropic', ANTHROPIC_THINKING), reasoning: REDACTED_AND_EMPTY, keepsPriorThinking: false },
+  { providerCase: thinkingCase('anthropic promptCache thinking', 'anthropic promptCache', ANTHROPIC_THINKING), reasoning: SIGNED, keepsPriorThinking: false },
+  { providerCase: thinkingCase('bedrock thinking', 'bedrock', BEDROCK_THINKING), reasoning: SIGNED, keepsPriorThinking: false },
+  { providerCase: thinkingCase('anthropic thinking replay', 'anthropic', ANTHROPIC_THINKING), reasoning: SIGNED, keepsPriorThinking: true },
+  { providerCase: thinkingCase('anthropic thinking redacted replay', 'anthropic', ANTHROPIC_THINKING), reasoning: REDACTED_AND_EMPTY, keepsPriorThinking: true },
+  { providerCase: thinkingCase('anthropic thinking interleaved replay', 'anthropic', ANTHROPIC_THINKING), reasoning: SIGNED, reasoningAfterText: MID_REPLY, keepsPriorThinking: true },
+  { providerCase: thinkingCase('anthropic promptCache thinking replay', 'anthropic promptCache', ANTHROPIC_THINKING), reasoning: SIGNED, keepsPriorThinking: true },
+  { providerCase: thinkingCase('bedrock thinking replay', 'bedrock', BEDROCK_THINKING), reasoning: SIGNED, keepsPriorThinking: true },
+  { providerCase: thinkingCase('bedrock thinking interleaved replay', 'bedrock', BEDROCK_THINKING), reasoning: SIGNED, reasoningAfterText: MID_REPLY, keepsPriorThinking: true },
+];
+
+const cases: ThinkingCase[] = [
+  ...PROVIDER_CASES.filter((providerCase) => providerCase.name in PROTOCOLS).map(
+    (providerCase): ThinkingCase => ({
+      providerCase,
+      reasoning: [],
+      keepsPriorThinking: false,
+    })
+  ),
+  ...THINKING_CASES,
+];
+
+const REASONING_BLOCK = /\{"type":"(?:thinking|redacted_thinking)"[^{}]*\},?|\{"reasoningContent":\{"reasoningText":\{[^{}]*\}\}\},?/g;
+
+const withoutReasoning = (segment: string): string =>
+  segment.replace(REASONING_BLOCK, '');
+
+const protocolOf = (providerCase: ProviderCase): Protocol =>
+  PROTOCOLS[providerCase.name] ??
+  (providerCase.provider === Providers.BEDROCK ? 'bedrock' : 'anthropic');
+
+/** Signatures and opaque reasoning data of a request body, in wire order. */
+const reasoningMarkers = (body: Json): string[] =>
+  JSON.stringify(body).match(/"(?:signature|data)":"[A-Z_]+_\d+"/g) ?? [];
+
+let signatureSerial = 0;
+
+/** Gives every reply of a scripted turn its own signatures. */
+function withReasoning(
+  reply: ScriptedReply,
+  reasoning: ScriptedReasoning[],
+  afterText: ScriptedReasoning[] | undefined
+): { reply: ScriptedReply; markers: string[] } {
+  const serial = ++signatureSerial;
+  const markers: string[] = [];
+  const unique = (block: ScriptedReasoning): ScriptedReasoning => {
+    if ('redacted' in block) {
+      markers.push(`"data":"${block.redacted}_${serial}"`);
+      return { redacted: `${block.redacted}_${serial}` };
+    }
+    markers.push(`"signature":"${block.signature}_${serial}"`);
+    return { ...block, signature: `${block.signature}_${serial}` };
+  };
+  if (reasoning.length === 0) {
+    return { reply, markers };
+  }
+  const isCallingText = (reply.text ?? '') !== '' && (reply.calls?.length ?? 0) > 0;
+  return {
+    reply: {
+      ...reply,
+      reasoning: reasoning.map(unique),
+      ...(afterText != null && isCallingText
+        ? { reasoningAfterText: afterText.map(unique) }
+        : {}),
+    },
+    markers,
+  };
+}
+
+interface PlayedTurns {
+  turns: LiveTurn[];
+  /** Per turn and request: markers of the replies sent before it. */
+  expectedMarkers: string[][][];
+}
+
+async function playTurns(
+  testCase: ThinkingCase,
+  replay: boolean
+): Promise<PlayedTurns> {
+  const { providerCase, reasoning, reasoningAfterText } = testCase;
+  const protocol = protocolOf(providerCase);
+  const model = (providerCase.clientOptions() as { model: string }).model;
+  const names = new Set(TOOL_OUTPUTS.keys());
+  const turns: LiveTurn[] = [];
+  const expectedMarkers: string[][][] = [];
+  const exchanges: Array<{ user: string; parts?: t.MessageContentComplex[] }> = [];
+  for (const turn of TURNS) {
+    exchanges.push({ user: turn.user });
+    const scripted = turn.replies.map((reply) =>
+      withReasoning(reply, reasoning, reasoningAfterText)
+    );
+    const live = await runLiveTurn(
+      {
+        agent: {
+          ...agentFor(providerCase.clientOptions(), providerCase.provider, true),
+          ...(replay ? { providerReasoningReplay: true } : {}),
+        },
+        toolResults: TOOL_OUTPUTS,
+        eventDriven: true,
+        transport: protocol === 'bedrock' ? 'bedrock' : 'fetch',
+        aggregatedEvents: [GraphEvents.ON_PROVIDER_OUTPUT_ITEMS],
+      },
+      restoreHistory(
+        exchanges,
+        names,
+        replay ? { provider: providerCase.provider, model } : undefined
+      ),
+      scripted.map(({ reply }) => scriptReply(protocol, reply))
+    );
+    expect(live.requests).toHaveLength(turn.replies.length);
+    exchanges[exchanges.length - 1].parts = live.contentParts;
+    turns.push(live);
+    expectedMarkers.push(
+      scripted.map((_, index) =>
+        scripted.slice(0, index).flatMap(({ markers }) => markers)
+      )
+    );
+  }
+  return { turns, expectedMarkers };
+}
+
+const boundaryPairs = (
+  providerCase: ProviderCase,
+  turns: LiveTurn[],
+  comparable: (segment: string) => string
+): Array<{ before: string[]; after: string[] }> => {
+  const marked = providerCase.breakpoints != null;
+  return turns.slice(1).map((turn, index) => {
+    const previous = turns[index].requests;
+    return {
+      before: segments(providerCase.reduce, previous[previous.length - 1], marked).map(comparable),
+      after: segments(providerCase.reduce, turn.requests[0], marked).map(comparable),
+    };
+  });
+};
+
+describe.each(cases.map((testCase) => [testCase.providerCase.name, testCase] as const))(
+  'live and restored requests: %s',
+  (_name, testCase) => {
+    const { providerCase, reasoning, keepsPriorThinking } = testCase;
+    const marked = providerCase.breakpoints != null;
+
+    it('turn N+1 starts with the bytes of turn N', async () => {
+      const { turns, expectedMarkers } = await playTurns(testCase, keepsPriorThinking);
+      turns.forEach(({ requests }, turnIndex) => {
+        for (let i = 1; i < requests.length; i++) {
+          const before = segments(providerCase.reduce, requests[i - 1], marked);
+          const after = segments(providerCase.reduce, requests[i], marked);
+          expect(after.slice(0, before.length)).toEqual(before);
+          const sent = JSON.stringify(requests[i]);
+          for (const marker of expectedMarkers[turnIndex][i]) {
+            expect(sent).toContain(marker);
+          }
+        }
+      });
+      if (keepsPriorThinking) {
+        /** Append-only: no thinking block is ever removed from the middle. */
+        const all = turns.flatMap(({ requests }) => requests);
+        for (let i = 1; i < all.length; i++) {
+          const before = reasoningMarkers(all[i - 1]);
+          expect(reasoningMarkers(all[i]).slice(0, before.length)).toEqual(before);
+        }
+        expect(reasoningMarkers(all[all.length - 1]).length).toBeGreaterThan(
+          reasoningMarkers(all[0]).length
+        );
+      }
+      const comparable = (segment: string): string =>
+        reasoning.length > 0 && !keepsPriorThinking
+          ? withoutReasoning(segment)
+          : segment;
+      for (const { before, after } of boundaryPairs(providerCase, turns, comparable)) {
+        expect(after.slice(0, before.length)).toEqual(before);
+      }
+    });
+
+    if (keepsPriorThinking) {
+      it('carries earlier turns thinking in the restored history', async () => {
+        const { turns, expectedMarkers } = await playTurns(testCase, true);
+        const lastOfFirstTurn = JSON.stringify(turns[0].requests[turns[0].requests.length - 1]);
+        const firstOfSecondTurn = JSON.stringify(turns[1].requests[0]);
+        for (const marker of expectedMarkers[0][expectedMarkers[0].length - 1]) {
+          expect(lastOfFirstTurn).toContain(marker);
+          expect(firstOfSecondTurn).toContain(marker);
+        }
+      });
+
+      /** Reverting replay (capture, restore or the agent flag) breaks the boundary. */
+      it('breaks the turn boundary when replay is off', async () => {
+        const { turns } = await playTurns(testCase, false);
+        const full = boundaryPairs(providerCase, turns, (segment) => segment);
+        expect(
+          full.some(({ before, after }) => {
+            const head = after.slice(0, before.length);
+            return JSON.stringify(head) !== JSON.stringify(before);
+          })
+        ).toBe(true);
+        for (const { before, after } of boundaryPairs(providerCase, turns, withoutReasoning)) {
+          expect(after.slice(0, before.length)).toEqual(before);
+        }
+      });
+    }
+  }
+);
diff --git a/src/specs/prompt-cache/prompt-cache.test.ts b/src/specs/prompt-cache/prompt-cache.test.ts
new file mode 100644
index 00000000..70d5678b
--- /dev/null
+++ b/src/specs/prompt-cache/prompt-cache.test.ts
@@ -0,0 +1,181 @@
+import type { CapturedTurn, Json } from './harness';
+import {
+  endOfText,
+  endOfTools,
+  countMatches,
+  toolSegments,
+  runConversation,
+  stripCacheMarkers,
+  commonPrefixLength,
+  serializeInCacheOrder,
+} from './harness';
+import { PROVIDER_CASES } from './providers';
+import { SCENARIOS } from './scenarios';
+
+jest.setTimeout(120_000);
+
+const isResetTurn = ({ reset }: CapturedTurn): boolean => reset;
+
+const marker = (value: Json): string =>
+  JSON.stringify(stripCacheMarkers(value));
+
+const escaped = (text: string): string => JSON.stringify(text).slice(1, -1);
+
+/** System prompt without this turn's volatile part, which may differ per turn. */
+const fixedSystem = ({ request, turn }: CapturedTurn): string => {
+  const system = marker(request.system);
+  return turn.additionalInstructions == null
+    ? system
+    : system.replace(escaped(turn.additionalInstructions), '');
+};
+
+/** Start of the segment that carries the volatile part, or the full length. */
+const reusableLength = (serialized: string, { turn }: CapturedTurn): number => {
+  if (turn.additionalInstructions == null) {
+    return serialized.length;
+  }
+  const start = serialized.indexOf(escaped(turn.additionalInstructions));
+  return start < 0 ? serialized.length : serialized.lastIndexOf('\n', start) + 1;
+};
+
+function roleOf(message: Json): string | undefined {
+  if (message == null || typeof message !== 'object' || Array.isArray(message)) {
+    return undefined;
+  }
+  const role = message.role;
+  return typeof role === 'string' ? role : undefined;
+}
+
+describe.each(PROVIDER_CASES.map((providerCase) => [providerCase.name, providerCase]))(
+  'prompt cache: %s',
+  (_name, providerCase) => {
+    describe.each(SCENARIOS.map((scenario) => [scenario.name, scenario]))(
+      '%s',
+      (_scenarioName, scenario) => {
+        let conversations: CapturedTurn[][];
+
+        beforeAll(async () => {
+          conversations = [];
+          for (const conversation of scenario.conversations) {
+            conversations.push(
+              await runConversation(providerCase, scenario, conversation)
+            );
+          }
+        });
+
+        const allTurns = (): CapturedTurn[] => conversations.flat();
+
+        const consecutiveTurns = (
+          select: (next: CapturedTurn) => boolean
+        ): Array<[CapturedTurn, CapturedTurn]> =>
+          conversations.flatMap((turns) =>
+            turns
+              .slice(1)
+              .map((next, i): [CapturedTurn, CapturedTurn] => [turns[i], next])
+              .filter(([, next]) => select(next))
+          );
+
+        it('keeps the conversation block in the system prompt', () => {
+          for (const captured of allTurns()) {
+            const system = JSON.stringify(captured.request.system);
+            expect(system).toContain(escaped(captured.conversationInstructions));
+            expect(system).toContain(escaped(captured.instructions));
+          }
+        });
+
+        it('moves only the per-turn volatile part, and only where documented', () => {
+          for (const { request, turn } of allTurns()) {
+            if (turn.additionalInstructions == null) {
+              continue;
+            }
+            const volatile = escaped(turn.additionalInstructions);
+            const inSystem = JSON.stringify(request.system).includes(volatile);
+            expect(inSystem).toBe(providerCase.movesDynamicPart !== true);
+            expect(JSON.stringify(request.messages).includes(volatile)).toBe(
+              !inSystem
+            );
+          }
+        });
+
+        it('keeps tools and system fixed between reset points', () => {
+          for (const [previous, next] of consecutiveTurns(
+            (turn) => !isResetTurn(turn)
+          )) {
+            expect(toolSegments(next.request).map(marker)).toEqual(
+              toolSegments(previous.request).map(marker)
+            );
+            expect(fixedSystem(next)).toBe(fixedSystem(previous));
+          }
+        });
+
+        it('starts every request with the previous one up to its volatile part', () => {
+          for (const [previous, next] of consecutiveTurns(
+            (turn) => !isResetTurn(turn)
+          )) {
+            const before = serializeInCacheOrder(previous.request);
+            const after = serializeInCacheOrder(next.request);
+            const required = next.followUp
+              ? before.length
+              : reusableLength(before, previous);
+            expect(commonPrefixLength(before, after)).toBeGreaterThanOrEqual(
+              required
+            );
+          }
+        });
+
+        it('keeps the cached prefix up to the declared boundary at reset points', () => {
+          for (const [previous, next] of consecutiveTurns(isResetTurn)) {
+            const before = serializeInCacheOrder(previous.request);
+            const after = serializeInCacheOrder(next.request);
+            const appendsTools =
+              (next.turn.compaction?.appendTools?.length ?? 0) > 0;
+            const boundary = appendsTools
+              ? endOfTools(previous.request)
+              : endOfText(before, previous.instructions);
+            expect(boundary).toBeGreaterThan(0);
+            expect(commonPrefixLength(before, after)).toBeGreaterThanOrEqual(
+              boundary
+            );
+            if (next.turn.compaction != null) {
+              expect(after).toContain(escaped(next.turn.compaction.summary));
+            }
+          }
+        });
+
+        if (scenario.conversations.length > 1) {
+          it('shares tools and stable instructions across conversations', () => {
+            const [first, second] = conversations.map((turns) =>
+              serializeInCacheOrder(turns[0].request)
+            );
+            expect(commonPrefixLength(first, second)).toBeGreaterThanOrEqual(
+              endOfText(first, scenario.instructions)
+            );
+          });
+        }
+
+        if (providerCase.breakpoints != null) {
+          const { pattern, max } = providerCase.breakpoints;
+          it(`uses at most ${max} cache breakpoints per request`, () => {
+            for (const { request } of allTurns()) {
+              const count = countMatches(request.raw, pattern);
+              expect(count).toBeGreaterThan(0);
+              expect(count).toBeLessThanOrEqual(max);
+            }
+          });
+        }
+
+        if (providerCase.strictAlternation === true) {
+          it('never sends two user messages in a row', () => {
+            for (const { request } of allTurns()) {
+              const roles = request.messages.map(roleOf);
+              for (let i = 1; i < roles.length; i++) {
+                const pair = `${roles[i - 1]}>${roles[i]}`;
+                expect(['user>user', 'human>human']).not.toContain(pair);
+              }
+            }
+          });
+        }
+      }
+    );
+  }
+);
diff --git a/src/specs/prompt-cache/reasoningReplay.test.ts b/src/specs/prompt-cache/reasoningReplay.test.ts
