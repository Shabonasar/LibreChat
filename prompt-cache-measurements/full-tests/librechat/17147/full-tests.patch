+  webSearch?: boolean;
+  toolFiles?: boolean;
+  /** Request stage: what `AgentClient.buildMessages` adds. */
+  rag?: string;
+  memory?: string;
+  agentFiles?: string;
+  mcp?: string;
+  /** Uploads staged for this turn's code execution (`queued_code_files`). */
+  queuedFile?: boolean;
+  promptCache?: boolean;
+}
+
