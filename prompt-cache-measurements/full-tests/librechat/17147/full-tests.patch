+      ...(initialSummary ? { initialSummary } : {}),
+      ...(customHandlers ? { customHandlers: customHandlers as never } : {}),
+    });
+    await run
+      .processStream({ messages }, { configurable: { thread_id: runId }, version: 'v2' })
+      .catch(() => undefined);
