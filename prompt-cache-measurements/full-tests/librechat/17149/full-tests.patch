+    const graphAgents = (runSpy.mock.calls[0][0] as { graphConfig: { agents: GraphInput[] } })
+      .graphConfig.agents;
+    const project = (input: GraphInput): Json =>
+      redact({
+        agentId: input.agentId,
+        instructions: input.instructions,
+        ...(input.conversation_instructions != null && {
