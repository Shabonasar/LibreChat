+      const allowed = await playConversation(openAI, toDispatch, {
+        approval: { enabled: true, allow: others, allowAlways: true },
+        toolApprovalAllows: [QUERY],
+      });
+      expect(allowed.calls).toEqual([{ name: QUERY, args: { q: 'bolts' } }]);
+    });
+  });
+
+  describe('reverting the dispatcher entry of the formatter tool set', () => {
+    it('strips the stored dispatcher call and breaks the next turn prefix', async () => {
+      const [openAI] = PROVIDERS;
+      const { played } = await playConversation(openAI, SCENARIO.slice(0, 4), {
+        toolSetOf: (agent) => {
+          const toolSet = buildToolSet(agent as never);
+          toolSet.delete(TOOL_DISPATCHER_NAME);
+          return toolSet;
+        },
+      });
+      const [, followUp] = played[2].requests;
+      const next = played[3].requests[0];
+      expect(serialize(next.messages.slice(0, followUp.messages.length))).not.toBe(
+        serialize(followUp.messages),
+      );
+    });
+  });
+
+  describe.each(ALL_CASES.map((providerCase) => [providerCase.name, providerCase] as const))(
+    'built-in capabilities: %s',
+    (_name, providerCase) => {
+      let result: Awaited<ReturnType<typeof playConversation>>;
+      let turns: Captured[][];
+
+      beforeAll(async () => {
+        result = await playConversation(providerCase, BUILTIN_SCENARIO, {
+          approval: BUILTIN_APPROVAL,
+        });
+        turns = result.played.map(({ requests }) => requests);
+      });
+
+      it('answers every scripted request', () => {
+        turns.forEach((requests, i) =>
+          expect(requests).toHaveLength(BUILTIN_SCENARIO[i].replies?.length ?? 1),
+        );
+      });
+
+      it('keeps tools and system byte-identical while built-ins are switched', () => {
+        const first = turns[0][0];
+        expect(toolNames(first)).toEqual([
+          'bash_tool',
+          'create_file',
+          'edit_file',
+          'read_file',
+          'delete_memory',
+          'set_memory',
+          'tool_search',
+          SEARCH,
+          TOOL_DISPATCHER_NAME,
+        ]);
+        for (const request of turns.slice(0, RESET_TURN).flat()) {
+          expect(serialize(request.tools)).toBe(serialize(first.tools));
+          expect(serialize(request.system)).toBe(serialize(first.system));
+        }
+        expect(json(first.system)).not.toContain(WEB_SEARCH_GUIDE);
+      });
+
+      it('starts every request with all bytes of the one before it, except at the reset', () => {
+        const all = turns.flat();
+        const resetAt = turns.slice(0, RESET_TURN).flat().length;
+        /** The request right after the refused call, whose result ends the one before it. */
+        const afterRefusal = turns.slice(0, 3).flat().length;
+        for (let i = 1; i < all.length; i++) {
+          const previous =
+            i === afterRefusal && ERROR_STATUS_NOT_RESTORED.has(providerCase.name)
+              ? all[i - 1].messages.slice(0, -1)
+              : all[i - 1].messages;
+          const prefix = serialize(all[i].messages.slice(0, previous.length));
+          if (i === resetAt) {
+            expect(prefix).not.toBe(serialize(previous));
+          } else {
+            expect(prefix).toBe(serialize(previous));
+          }
+        }
+      });
+
+      it('announces a built-in with its instructions, switching off and on again', () => {
+        const sent = turns.map((requests) => requests[0]);
+        expect(lastMessage(sent[1])).toContain(
+          'Tools of built-in capability `web_search` are now available.',
+        );
+        expect(lastMessage(sent[1])).toContain(WEB_SEARCH_GUIDE);
+        expect(lastMessage(sent[2])).toContain(
+          'Tools of built-in capability `execute_code` were switched off',
+        );
+        expect(lastMessage(sent[3])).toContain(
+          'Tools of built-in capability `execute_code` are available again.',
+        );
+      });
+
+      it('runs a dispatched built-in under its own name and refuses a switched-off one', () => {
+        expect(result.calls).toEqual([{ name: 'web_search', args: { query: 'bolts' } }]);
+        expect(result.hookNames).toEqual(['web_search']);
+        const [, refused, followUp] = turns[2];
+        const appended = json(followUp.messages.slice(refused.messages.length));
+        expect(appended).toContain('is disabled in this conversation');
+      });
+
+      it('re-anchors at a declared reset: keeps the order and appends the deferred built-in', () => {
+        const reset = result.played[RESET_TURN];
+        expect(reset.plan.reset).toEqual(['model']);
+        expect(reset.plan.anchorTarget).toEqual({ messageId: `u${RESET_TURN + 1}` });
+        const before = toolNames(turns[0][0]);
+        const after = toolNames(turns[RESET_TURN][0]);
+        expect(after).toEqual([...before.slice(0, -1), 'web_search', TOOL_DISPATCHER_NAME]);
+        expect(json(turns[RESET_TURN][0].system)).toContain(WEB_SEARCH_GUIDE);
+        expect(json(turns[RESET_TURN][0].messages)).not.toContain('context_update');
+        const next = turns[RESET_TURN + 1][0];
+        expect(serialize(next.tools)).toBe(serialize(turns[RESET_TURN][0].tools));
+        expect(serialize(next.system)).toBe(serialize(turns[RESET_TURN][0].system));
+        expect(result.played[RESET_TURN + 1].plan.reset).toBeUndefined();
+      });
+    },
+  );
+});
diff --git a/packages/api/src/agents/contextUpdates.boundary.spec.ts b/packages/api/src/agents/contextUpdates.boundary.spec.ts
new file mode 100644
index 000000000..6ab91a4c4
--- /dev/null
+++ b/packages/api/src/agents/contextUpdates.boundary.spec.ts
@@ -0,0 +1,93 @@
+import { ContentTypes } from 'librechat-data-provider';
+import { formatAgentMessages, formatMessage } from '@librechat/agents';
+import { findSummaryBoundaryIndex } from './contextUpdates';
+
+type Row = {
+  messageId: string;
+  isCreatedByUser: boolean;
+  sender: string;
+  text: string;
+  content?: unknown[];
+};
+
+const user = (n: number): Row => ({
+  messageId: `u${n}`,
+  isCreatedByUser: true,
+  sender: 'User',
+  text: `question-${n}`,
+});
+
+const assistant = (n: number, summary?: { retainedFromMessageId?: string }): Row => ({
+  messageId: `a${n}`,
+  isCreatedByUser: false,
+  sender: 'Assistant',
+  text: `answer-${n}`,
+  content: [
+    ...(summary
+      ? [
+          {
+            type: ContentTypes.SUMMARY,
+            content: [{ type: ContentTypes.TEXT, text: 'Earlier discussion.' }],
+            boundary: { messageId: `a${n}`, contentIndex: 0 },
+            ...(summary.retainedFromMessageId ? { coverage: summary } : {}),
+          },
+        ]
+      : []),
+    { type: ContentTypes.TEXT, text: `answer-${n}` },
+  ],
+});
+
+/** The user questions the SDK formatter keeps in the prompt, in order. */
+function visibleQuestions(rows: Row[]): string[] {
+  /** The formatter resolves `coverage` through the source message ids, which the payload keeps. */
+  const formatted = rows.map((message) => ({
+    ...formatMessage({ message: message as never }),
+    messageId: message.messageId,
+  }));
+  const { messages } = formatAgentMessages(formatted as never, {});
+  return messages
+    .filter((message) => message.getType() === 'human')
+    .map((message) => JSON.stringify(message.content))
+    .flatMap((text) => text.match(/question-\d+/g) ?? []);
+}
+
+const questionsFrom = (rows: Row[], index: number) =>
+  rows
+    .slice(index)
+    .filter((row) => row.isCreatedByUser)
+    .map((row) => row.text);
+
+/**
+ * `findSummaryBoundaryIndex` mirrors the SDK formatter's summary boundary. If the formatter
+ * changes where it cuts the history, these cases fail and the predicate must follow.
+ */
+describe('findSummaryBoundaryIndex against the SDK formatter', () => {
+  const cases: Array<[string, Row[]]> = [
+    ['no summary', [user(1), assistant(1), user(2), assistant(2), user(3)]],
+    [
+      'summary on an earlier answer keeps history from that answer',
+      [user(1), assistant(1, {}), user(2), assistant(2), user(3)],
+    ],
+    [
+      'latest of two summaries wins',
+      [user(1), assistant(1, {}), user(2), assistant(2, {}), user(3)],
+    ],
+    [
+      'coverage names an earlier retained user message',
+      [user(1), assistant(1), user(2), assistant(2, { retainedFromMessageId: 'u2' }), user(3)],
+    ],
+    [
+      'coverage names a later message than the carrier',
+      [user(1), assistant(1, { retainedFromMessageId: 'u2' }), user(2), assistant(2), user(3)],
+    ],
+  ];
+
+  it.each(cases)('%s', (_name, rows) => {
+    const boundary = findSummaryBoundaryIndex(rows);
+    const visible = visibleQuestions(rows);
+    const expected = questionsFrom(rows, boundary);
+    /** The formatter may reopen the history with the carrier's own question; never with older ones. */
+    expect(visible.slice(-expected.length)).toEqual(expected);
+    expect(visible.length - expected.length).toBeLessThanOrEqual(0);
+  });
+});
diff --git a/packages/api/src/agents/contextUpdates.spec.ts b/packages/api/src/agents/contextUpdates.spec.ts
new file mode 100644
index 000000000..986488dc3
--- /dev/null
+++ b/packages/api/src/agents/contextUpdates.spec.ts
@@ -0,0 +1,201 @@
+import { ContentTypes } from 'librechat-data-provider';
+import {
+  formatContextUpdate,
+  findSummaryBoundaryIndex,
+  hasConversationDateContext,
+  findSummarySegment,
+  getTurnContextUpdates,
+  getTurnUserMessageCreatedAt,
+  createHistoryContextUpdates,
+} from './contextUpdates';
+import type { ContextUpdateMessage } from './contextUpdates';
+
+const user = (messageId: string, createdAt?: string): ContextUpdateMessage => ({
+  messageId,
+  isCreatedByUser: true,
+  createdAt,
+});
+const assistant = (
+  messageId: string,
+  createdAt: string,
+  content?: unknown[],
+): ContextUpdateMessage => ({ messageId, isCreatedByUser: false, createdAt, content });
+
+const summaryPart = (coverage?: { retainedFromMessageId?: string }) => ({
+  type: ContentTypes.SUMMARY,
+  content: [{ type: ContentTypes.TEXT, text: 'Earlier discussion.' }],
+  boundary: { messageId: 'm', contentIndex: 0 },
+  ...(coverage ? { coverage } : {}),
+});
+
+/** 23:00 on Monday 2026-03-09 in Nairobi (UTC+3). */
+const START = '2026-03-09T20:00:00.000Z';
+
+describe('formatContextUpdate', () => {
+  it('wraps lines in a context_update block', () => {
+    expect(formatContextUpdate(['a', 'b'])).toBe('<context_update>\na\nb\n</context_update>');
+  });
+});
+
+describe('findSummaryBoundaryIndex', () => {
+  it('is 0 without a summary', () => {
+    expect(findSummaryBoundaryIndex([user('u1'), assistant('a1', START)])).toBe(0);
+  });
+
+  it('keeps history from the message carrying the latest usable summary', () => {
+    const messages = [
+      user('u1'),
+      assistant('a1', START, [summaryPart()]),
+      user('u2'),
+      assistant('a2', START, [summaryPart()]),
+      user('u3'),
+    ];
+    expect(findSummaryBoundaryIndex(messages)).toBe(3);
+  });
+
+  it('keeps history from the covered message in coverage mode', () => {
+    const messages = [
+      user('u1'),
+      assistant('a1', START),
+      user('u2'),
+      assistant('a2', START, [summaryPart({ retainedFromMessageId: 'u2' })]),
+    ];
+    expect(findSummaryBoundaryIndex(messages)).toBe(2);
+  });
+
+  it('falls back to the carrying message when coverage names an unknown or later message', () => {
+    const messages = [
+      user('u1'),
+      assistant('a1', START, [summaryPart({ retainedFromMessageId: 'u2' })]),
+      user('u2'),
+    ];
+    expect(findSummaryBoundaryIndex(messages)).toBe(1);
+  });
+
+  it('ignores summaries that failed or never finished', () => {
+    const messages = [
+      user('u1'),
+      assistant('a1', START, [{ ...summaryPart(), failed: true }]),
+      assistant('a2', START, [{ ...summaryPart(), boundary: undefined }]),
+    ];
+    expect(findSummaryBoundaryIndex(messages)).toBe(0);
+  });
+});
+
+describe('findSummarySegment', () => {
+  it('reports the message carrying the latest usable summary and the first visible one', () => {
+    const messages = [
+      user('u1', START),
+      assistant('a1', START, [summaryPart()]),
+      user('u2', START),
+      assistant('a2', START, [summaryPart({ retainedFromMessageId: 'u2' })]),
+      user('u3'),
+    ];
+    expect(findSummarySegment(messages)).toEqual({ carrier: 3, visibleFrom: 2 });
+    expect(findSummarySegment([user('u1'), assistant('a1', START)])).toEqual({
+      carrier: -1,
+      visibleFrom: 0,
+    });
+  });
+});
+
+describe('getTurnContextUpdates', () => {
+  const entries = [{ key: 'artifacts', value: 'default' }];
+  it('returns the entries only for the user message they were planned for', () => {
+    const req = { turnContextUpdates: { messageId: 'u2', entries } };
+    expect(getTurnContextUpdates(req, 'u2')).toBe(entries);
+    expect(getTurnContextUpdates(req, 'u1')).toBeUndefined();
+    expect(getTurnContextUpdates({}, 'u2')).toBeUndefined();
+    expect(getTurnContextUpdates(undefined, undefined)).toBeUndefined();
+  });
+});
+
+describe('hasConversationDateContext', () => {
+  it('detects the web search runtime context or temporal instructions', () => {
+    expect(hasConversationDateContext([{ dynamicToolContextMap: { web_search: 'x' } }])).toBe(true);
+    expect(
+      hasConversationDateContext([
+        {},
+        { dynamicToolContextMap: { agent_temporal_instructions: 'Today is ...' } },
+      ]),
+    ).toBe(true);
+    expect(hasConversationDateContext([null, { dynamicToolContextMap: { other: 'x' } }])).toBe(
+      false,
+    );
+  });
+});
+
+const STABLE_CONFIG = { endpoints: { agents: { promptCache: { stableContext: true } } } };
+const TIMESTAMPS_CONFIG = { endpoints: { agents: { promptMessageTimestamps: true } } };
+
+describe('getTurnUserMessageCreatedAt', () => {
+  const turnStartedAt = Date.parse('2026-10-14T13:41:07.250Z');
+
+  it.each([
+    ['stableContext', STABLE_CONFIG],
+    ['promptMessageTimestamps', TIMESTAMPS_CONFIG],
+  ])('dates the stored user message by the turn start with %s', (_name, config) => {
+    expect(getTurnUserMessageCreatedAt({ turnStartedAt, config })).toEqual(new Date(turnStartedAt));
+  });
+
+  it('leaves the storage timestamp when neither feature that reads it is on', () => {
+    expect(getTurnUserMessageCreatedAt({ turnStartedAt })).toBeUndefined();
+    expect(getTurnUserMessageCreatedAt({ turnStartedAt, config: {} })).toBeUndefined();
+  });
+
+  it('leaves the storage timestamp when the turn start is unknown', () => {
+    expect(getTurnUserMessageCreatedAt(undefined)).toBeUndefined();
+    expect(getTurnUserMessageCreatedAt({ config: STABLE_CONFIG })).toBeUndefined();
+    expect(
+      getTurnUserMessageCreatedAt({ turnStartedAt: Number.NaN, config: STABLE_CONFIG }),
+    ).toBeUndefined();
+  });
+});
+
+describe('createHistoryContextUpdates', () => {
+  const AGENT_WITH_DATE = { dynamicToolContextMap: { web_search: 'stated' } };
+  const messages = [
+    user('u1', START),
+    assistant('a1', START),
+    user('u2', '2026-03-10T10:00:00.000Z'),
+  ];
+  const run = (config: object, agents: object[] = [AGENT_WITH_DATE]) => {
+    const history = createHistoryContextUpdates({
+      req: {
+        conversationCreatedAt: START,
+        turnStartedAt: '2026-03-10T10:00:00.000Z',
+        body: { timezone: 'Africa/Nairobi' },
+        config,
+      },
+      messages,
+      agents,
+    });
+    const formatted = messages.map(() => ({ content: 'text' }));
+    const applied = formatted.map((message, index) => history.apply(message as never, index));
+    return { history, formatted, applied };
+  };
+
+  it('prepends the date-change note to the prompt copy with stableContext', () => {
+    const { history, formatted, applied } = run(STABLE_CONFIG);
+    expect(history.hasUpdates).toBe(true);
+    expect(applied[2]).toContain('Current date changed to: 2026-03-10 (Tue)');
+    expect(formatted[2].content).toContain(applied[2] as string);
+    expect(formatted[0].content).toBe('text');
+  });
+
+  it('announces nothing without stableContext, so the history is as stored', () => {
+    const { history, formatted } = run({});
+    expect(history.hasUpdates).toBe(false);
+    expect(formatted.every((message) => message.content === 'text')).toBe(true);
+  });
+
+  it('announces nothing when no agent states the conversation date', () => {
+    expect(run(STABLE_CONFIG, [{}]).history.hasUpdates).toBe(false);
+  });
+
+  it('stamps send times only with promptMessageTimestamps', () => {
+    const { applied } = run(TIMESTAMPS_CONFIG);
+    expect(applied[0]).toContain('Message sent: 2026-03-09 23:00:00 +03:00 (Mon)');
+    expect(applied[2]).not.toContain('Current date changed');
+  });
+});
diff --git a/packages/api/src/agents/promptCache.spec.ts b/packages/api/src/agents/promptCache.spec.ts
