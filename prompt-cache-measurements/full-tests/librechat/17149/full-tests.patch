+        );
+        child.alwaysApplySkillPrimes = [
+          { name: 'house-style', body: 'Use sentence case.\n', skillId: 'skill-1', version: 1 },
+        ];
+        const parent = await prepareAgent(
+          {
+            provider: Providers.ANTHROPIC,
+            promptCache,
+            instructions: 'Parent.',
+            webSearch: true,
